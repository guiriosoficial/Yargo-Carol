{
  "name": "yargo-carol",
  "author": {
    "name": "Guilherme Rios da Cunha",
    "email": "guilherme.rc.98@gmail.com",
    "url": "https://guiriosoficial.github.io"
  },
  "bugs": "https://github.com/guiriosoficial/Yargo-Carol/issues",
  "homepage": "http://yargoecarol.com.br",
  "version": "1.0.0",
  "license": "MIT",
  "keywords": [
    "basic",
    "fly-ins",
    "jquery",
    "minimalist",
    "parallax",
    "responsive",
    "rustic",
    "template",
    "website",
    "wedding"
  ],
  "description": "A responsive wedding website template with a minimalists and rustics design including a beautiful parallax and a simple fly-in effect.",
  "repository": {
    "type": "git",
    "url": "https://github.com/guiriosoficial/Yargo-Carol"
  },
  "main": "app/index.html",
  "private": true,
  "scripts": {
    "dev": "vite",
    "serve:test": "cross-env NODE_ENV=test gulp serve",
    "serve:dist": "cross-env NODE_ENV=production gulp serve",
    "start": "gulp serve",
    "build": "cross-env NODE_ENV=production gulp",
    "test": "npm run serve:test",
    "tasks": "gulp --tasks"
  },
  "devDependencies": {
    "@babel/core": "~7.17.0",
    "@babel/preset-env": "~7.16.11",
    "@vitejs/plugin-legacy": "^7.2.1",
    "autoprefixer": "~10.4.2",
    "browser-sync": "~2.27.7",
    "cross-env": "~7.0.3",
    "cssnano": "~5.0.16",
    "del": "~6.0.0",
    "sass": "^1.97.3",
    "vite": "^7.3.1"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "Firefox ESR",
    "not ie <= 8"
  ],
  "eslintConfig": {
    "parserOptions": {
      "sourceType": "module"
    },
    "env": {
      "es6": true,
      "node": true,
      "browser": true,
      "jquery": true
    },
    "rules": {
      "quotes": [
        2,
        "single"
      ]
    }
  }
}
